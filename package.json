{
  "name": "react-stack-webapp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "client:dev": "npm run dev --workspace=client",
    "client:build": "npm run build --workspace=client",
    "server:dev": "npm run dev --workspace=server",
    "server:start": "npm run start --workspace=server",
    "dev": "npm run server:dev & npm run client:dev"
  },
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint",
      "prettier --write"
    ]
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^8.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^2.8.8"
  }
}
